   <Label fx:id="lblFinal1" layoutX="393.0" layoutY="217.0" prefHeight="44.0" prefWidth="163.0" styleClass="caja" />
   <ImageView fitHeight="86.0" fitWidth="117.0" layoutX="648.0" layoutY="123.0" pickOnBounds="true" preserveRatio="true">
      <image>
