         <Label fx:id="lblSemi1" prefHeight="44.0" prefWidth="163.0" styleClass="caja" />
         <Label fx:id="lblSemi2" prefHeight="44.0" prefWidth="163.0" styleClass="caja" translateY="195.0" />
      </children>
   </VBox>
     <Label fx:id="lblFinal2" layoutX="807.0" layoutY="217.0" prefHeight="44.0" prefWidth="163.0" styleClass="caja" />
