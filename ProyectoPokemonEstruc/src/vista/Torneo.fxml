<AnchorPane prefHeight="555.0" prefWidth="1357.0" style="-fx-background-color: #f0f8ff;" stylesheets="@../resources/styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.TorneoController">
   <ImageView fitHeight="565.0" fitWidth="1461.0" layoutY="-9.0" pickOnBounds="true">
      <image>
         <Image url="@../resources/torneo.png" />
      </image>
   </ImageView>

    <!-- Botón para avanzar a la siguiente ronda -->
    <Button fx:id="btnSiguiente" layoutX="581.0" layoutY="459.0" onMouseClicked="#JugarRonda" prefHeight="54.0" prefWidth="220.0" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-size: 14px; -fx-background-radius: 10;" text="Siguiente Ronda" />

    <!-- Jugadores del lado izquierdo -->
    <VBox fx:id="boxParticipantesIzq" layoutX="30.0" layoutY="26.0" prefHeight="433.0" prefWidth="160.0" spacing="20" stylesheets="@../resources/styles.css">
