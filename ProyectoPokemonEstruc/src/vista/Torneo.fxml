        <Label fx:id="lblP2" prefHeight="44.0" prefWidth="163.0" styleClass="caja" stylesheets="@../resources/styles.css" translateY="50.0" />
        <Label fx:id="lblP3" prefHeight="44.0" prefWidth="163.0" styleClass="caja" stylesheets="@../resources/styles.css" translateY="150.0" />
