<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<ScrollPane fx:id="scrEntrenadores" fitToHeight="true" fitToWidth="true" prefHeight="780.0" prefWidth="1500.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.EntrenadoresController">
   <content>
      <AnchorPane fx:id="anpFrame" prefHeight="780.0" prefWidth="1500.0">
         <children>
            
            <!-- Card for Entrenador 1 -->
            <StackPane fx:id="stpEntrenador1" layoutX="32.0" layoutY="47.0" onMouseClicked="#selectEntrenador1" prefHeight="233.0" prefWidth="198.0" stylesheets="@../resources/styles.css">
               <children>
                  <Label fx:id="lblEntrenador1" alignment="BOTTOM_LEFT" contentDisplay="TOP" layoutX="50.0" layoutY="20.0" styleClass="trainer-name" stylesheets="@../resources/styles.css" text="ASH" translateY="-85.0" StackPane.alignment="CENTER">
                     <font>
                        <Font name="Showcard Gothic" size="12.0" />
                     </font>
                  </Label>
                  <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" translateY="25.0">
                     <image>
                        <Image url="@../resources/ash.png" />
                     </image>
                  </ImageView>
               </children>
               <styleClass>
                  <String fx:value="entrenador-card-ash" />
                  <String fx:value="entrenador-card" />
               </styleClass>
            </StackPane>

            <!-- Efecto emergente al pasar el mouse -->
            <Tooltip fx:id="tooltipEntrenador1" styleClass="tooltip-card" text="Especialidad: Fuego\nGeneración: 1\nPokémon Favorito: Charizard" />
            
         </children>
      </AnchorPane>
   </content>
</ScrollPane>
